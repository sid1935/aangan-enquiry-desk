# Copy to .env and fill in. Never commit .env.

# Vaani voice platform (Developers > API Keys)
VAANI_API_KEY=
VAANI_AGENT_ID=

# Gemini (Google AI Studio)
LLM_PROVIDER=gemini
LLM_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Estimated USD per 1M tokens, used only for the cost figures. Check Google's current pricing.
PRICE_IN_PER_M=0.3
PRICE_OUT_PER_M=2.5

# Telegram handoff (create a bot with @BotFather, message it, then read your chat id from getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Long random string. It becomes part of the webhook URL: /webhook/<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Vercel / production: optional dashboard password (any username). Leave empty for a PUBLIC dashboard. Plus the Supabase log (Project Settings > API)
DASHBOARD_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot CRM (optional). A Private App access token with contacts, deals, tasks and notes write scopes. Leave empty to keep the CRM off.
HUBSPOT_TOKEN=
# Optional: your HubSpot account (portal) id, only used to make dashboard links open the record
HUBSPOT_PORTAL_ID=
# Optional: your HubSpot region host, e.g. app-na2.hubspot.com (shown in the HubSpot URL). Defaults to app.hubspot.com
HUBSPOT_UI_DOMAIN=
